# 复制为 .env 后按部署环境修改。
# 本地：APP_ENV=local，先执行 docker start code-rag-pg
# 服务器：APP_ENV=prod，后端与 PG 各自容器，PG 服务名为 pg

APP_ENV=local

DB_USER=rag
DB_PASSWORD=rag123
DB_NAME=code_rag
DB_PORT=5432
# 留空则按 APP_ENV 自动解析主机（local→localhost / prod→pg）
# DB_HOST=

# 可选完整连接串（最高优先级，会覆盖 APP_ENV 解析）
# DATABASE_URL=

CHROMA_DIR=./data/chroma

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

REPO_URL=https://github.com/google/gson.git
