# ---- Python 虚拟环境 / 依赖产物 ----
venv/
.venv/
*.egg-info/
build/
dist/

# ---- Python 编译缓存 ----
__pycache__/
*.py[cod]
*.so

# ---- 测试 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example

# ---- 本地运行时数据（向量库、克隆的代码仓库、数据库）----
data/
*.db
*.sqlite
*.sqlite3

# ---- 日志 ----
logs/
*.log

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.iml

# ---- 操作系统 ----
.DS_Store
Thumbs.db
